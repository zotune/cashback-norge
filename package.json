{
  "name": "cashback-norge",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:backend && pnpm run build:extension && pnpm run build:site && pnpm run build:userscript",
    "build:userscript": "vite build --config vite.userscript.config.ts",
    "build:backend": "tsc --project tsconfig.backend.json",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:extension:store": "pnpm run build:extension && node scripts/build-extension-store.mjs",
    "build:store": "pnpm run build:extension:store",
    "build:site": "vite build --config vite.site.config.ts",
    "check": "tsc --project tsconfig.json --noEmit",
    "crawl": "tsx src/backend/index.ts && cp data/cashback-index.json site/cashback-index.json && pnpm run build:extension && pnpm run build:site && pnpm run build:userscript"
  },
  "dependencies": {
    "crawlee": "^3.16.0",
    "naughty-words": "^1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/naughty-words": "^1.2.3",
    "@types/node": "^22.7.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b"
}
