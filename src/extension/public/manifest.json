{
  "manifest_version": 3,
  "name": "Cashback Norge",
  "description": "Shows cashback offers for supported stores.",
  "version": "0.1.9",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://browser-extension-backend.cloud.pji.nu/*",
    "https://native-backend.cloud.pji.nu/*",
    "https://godpris.no/*",
    "https://www.klarna.com/*",
    "https://gql.prisradar.no/*",
    "https://prisradar.no/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Cashback Norge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
