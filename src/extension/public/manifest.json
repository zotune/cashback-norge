{
  "manifest_version": 3,
  "name": "Cashback Norge",
  "description": "Shows cashback offers for supported stores.",
  "version": "0.2.6",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://browser-extension-backend.cloud.pji.nu/*",
    "https://native-backend.cloud.pji.nu/*",
    "https://godpris.no/*",
    "https://api.augmentedsteam.com/*",
    "https://api.gg.deals/*",
    "https://gg.deals/*",
    "https://www.allkeyshop.com/*",
    "https://itunes.apple.com/*",
    "https://appstoreprice.org/*",
    "https://namx6ho175-dsn.algolia.net/*",
    "https://isthereanydeal.com/*",
    "https://www.klarna.com/*",
    "https://www.playstation.com/*",
    "https://store.playstation.com/*",
    "https://www.vinmonopolet.no/*",
    "https://vinmonopolet.no/*",
    "https://open.er-api.com/*",
    "https://gql.prisradar.no/*",
    "https://prisradar.no/*",
    "https://www.sesum.no/*",
    "https://sesum.no/*",
    "https://enhver.no/*",
    "https://api.enhver.no/*",
    "https://kassal.app/*",
    "https://www.finn.no/*",
    "https://worka.panflights.com/*",
    "https://workb.panflights.com/*",
    "https://panflights.com/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Cashback Norge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
